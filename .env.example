# Optional. Without a key, BrainDump falls back to a simple rule-based categorizer.
ANTHROPIC_API_KEY=
PORT=5173

# Supabase: database, login, and file storage.
# Postgres connection string. In the Supabase dashboard: Connect > Session pooler. Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=
# Project URL, like https://abcdefgh.supabase.co
SUPABASE_URL=
# Project Settings > API Keys. The publishable key is sent to the browser; the secret key must stay on the server.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
