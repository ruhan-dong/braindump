{
  "name": "braindump",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "dev": "tsx watch --ignore 'src/**' --ignore 'data/**' server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test shared/rules.test.ts",
    "db:migrate": "tsx server/migrate.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "seed:import": "tsx server/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "postgres": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
